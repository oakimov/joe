=Ident			[near_white]
=Variable		+Ident
=DefinedIdent		+Ident
=Key			+Ident
=Value			+Ident
=Constant		[teal]
=Boolean		+Constant
=Preproc		[green]
=Define			+Preproc
=Precond		+Preproc
=Macro			+Preproc
=IncSystem		+Preproc
=IncLocal		+Preproc
=Escape			[orange]
=StringEscape		+Escape
=CharacterEscape	+Escape
=Operator		[near_white]
=Brace			+Operator
=Bad			[fg]/[ansi_red]
=Garbage		+Bad
=TODO			[amber] bold
=Title			[nord_blue] bold
=Tag			[lavender]
=TagName		+Tag
=TagEnd			+Tag
=TagEdge		+Tag
=Ignore			[muted] dim

=diff.AddLine		[pink]
=diff.DelLine		[near_white]
=diff.ChgLine		[orange]
=diff.Hunk		[muted]
=diff.FileNew		[muted]
=diff.FileOld		[muted]
=diff.Garbage		[muted]

